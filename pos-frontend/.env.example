VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key

# Optional. Leave unset in production. Set to "true" only for local offline demos.
# VITE_ALLOW_DEMO=true

# Optional app version string reported to branch telemetry
# VITE_APP_VERSION=1.0.0

# Cloudflare Pages / Turnstile (login protection). Sitekey is public.
# Set in Cloudflare Pages → Settings → Environment variables (rebuild required):
# VITE_TURNSTILE_SITEKEY=your_turnstile_site_key
#
# Fallback: public/captcha.json (used when env var is missing in the production build)
#
# Secret: Supabase → Authentication → Bot and Abuse Protection → Turnstile → Secret key
