VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key

# Optional. Leave unset in production. Set to "true" only for local offline demos.
# VITE_ALLOW_DEMO=true

# Optional app version string reported to branch telemetry
# VITE_APP_VERSION=1.0.0

# hCaptcha (login protection). Sitekey is public.
# VITE_HCAPTCHA_SITEKEY=5b304e0a-3d66-46e0-bcc0-922484306234
#
# Secret goes in Supabase Dashboard → Authentication → Bot and Abuse Protection
# → Enable CAPTCHA protection → provider hCaptcha → paste Secret key.
# The app passes captchaToken into supabase.auth.signInWithPassword (required by Auth).
#
# Hostnames in hCaptcha dashboard: add your production domain.
# For local testing, also add localhost — or temporarily disable Auth CAPTCHA while developing.
