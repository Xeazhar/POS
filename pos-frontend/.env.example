# ===========================================================================
# CalePOS environment
#
# READ THIS FIRST: local development and the deployed site must NOT point at
# the same Supabase project.
#
# The production database holds real fiscal records. Sales are immutable and
# OR numbers are sequential for BIR reasons — a test sale rung up on a laptop
# against production consumes a real OR number and cannot be deleted. Point
# your local build at the dev project instead.
#
# Copy this file to `.env.local` and fill in the DEV project values.
# `.env.local` is gitignored; never commit real keys.
# ===========================================================================


# --- Which tier is this build? ----------------------------------------------
# development | staging | production
#
# Anything other than `production` shows a loud environment badge in the app,
# so nobody has to guess which database they are looking at. An unset value is
# treated as `development` on purpose — the dangerous case must never be the
# quiet default.
#
# Local `.env.local`      → development
# Staging deploy          → staging
# Production deploy       → production   (set in the hosting dashboard, NOT here)
VITE_APP_ENV=development


# --- Supabase ---------------------------------------------------------------
# LOCAL DEVELOPMENT: use the dev project (e.g. calepos-dev).
# The deployed app gets its own values from the hosting platform's environment
# variables — see "Where each tier is configured" below.
#
# Only ever the publishable / anon key here. The service role key must never
# appear in frontend code or in any hosting env var for this app — access
# control is RLS, not key secrecy.
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_dev_publishable_anon_key


# --- Optional ---------------------------------------------------------------
# In-memory demo store, no backend at all. Local offline demos only.
# Production builds refuse demo login unless this is explicitly "true".
# VITE_ALLOW_DEMO=true

# Build-time override for the version string. Normally leave unset — the version
# comes from package.json and is baked in by vite.config.js.
# VITE_APP_VERSION=0.6.0

# Cloudflare Turnstile (login + staff account creation). The sitekey is public.
# Set per environment in the hosting dashboard; a rebuild is required.
# The matching SECRET goes in Supabase → Authentication → Bot and Abuse
# Protection → Turnstile, per project — dev and production each need their own.
# VITE_TURNSTILE_SITEKEY=your_turnstile_site_key
#
# Fallback when the env var is missing in a production build: public/captcha.json


# ===========================================================================
# Where each tier is configured
#
#   development   this file → copied to .env.local on each developer's machine
#                 Supabase project: calepos-dev
#                 Freely resettable. Wipe and reseed it whenever you like.
#
#   staging       hosting dashboard (Cloudflare Pages → preview/branch env vars)
#                 Supabase project: calepos-staging
#                 Mirrors the production schema. Used to rehearse a release and
#                 to test migrations BEFORE they touch production.
#
#   production    hosting dashboard (Cloudflare Pages → production env vars)
#                 Supabase project: calepos (the live one)
#                 Append-only, BIR-compliance-critical. Never recreated, never
#                 wiped, never pointed at from a laptop.
#
# Rule of thumb: if you are typing a Supabase URL into a file on your own
# machine, it must be the dev one.
# ===========================================================================
