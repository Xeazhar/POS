# ===========================================================================
# CalePOS load-test user provisioning
#
# Copy this file to `.env.test` (gitignored — never commit real values) and
# fill it in. Consumed ONLY by `npm run setup:load-test`
# (scripts/setup-load-test-users.mjs), a Node script that never ships in the
# frontend bundle.
#
# REQUIRED: point this at a DEDICATED load-test Supabase project — never at
# calepos-dev, calepos-staging, or the live `calepos` project. The script
# creates 28 real auth users and the stress tests then hammer whatever
# project you point it at with up to 200 concurrent simulated sales.
# ===========================================================================

# Project → Settings → API. Full admin access — never commit, never share,
# never reuse a dev/staging/production project's key here.
SUPABASE_URL=https://YOUR_LOAD_TEST_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_load_test_project_service_role_key

# Deliberate tripwire — the script refuses to run unless this exact literal
# is present, so a copy-pasted .env.test can't silently target the wrong
# project.
SUPABASE_TEST_CONFIRM=i-understand-this-is-not-production


# --- Cloudflare Turnstile test keys -----------------------------------------
# Cloudflare's official "always passes" dummy widget. This is a published
# testing constant, not a secret — safe to use verbatim.
#
# Frontend (build-time env var for the build you point at this project):
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
#
# Also required, one-time and manual (no API for this half): in the
# load-test Supabase project → Authentication → Bot and Abuse Protection →
# Turnstile, set the secret to Cloudflare's matching test secret:
#   1x0000000000000000000000000000AA
# Without this, sign-ins during the stress test will fail Supabase's captcha
# check even though the frontend widget itself "passes".


# ===========================================================================
# `npm run setup:load-test` appends a generated LOAD_TEST_CREDENTIALS block
# below this line in your `.env.test` (branch ids, login codes, PINs).
# Re-running the script updates that block in place — do not hand-edit it.
# ===========================================================================
